PORT=5000
# MongoDB is optional; without it, reports persist in server/data/reports.json.
MONGODB_URI=
# Set a long random secret to enable the moderation workspace.
ADMIN_TOKEN=
# Stable, random key for privacy-preserving anonymous community actions.
SUPPORT_SECRET=
# Set to 1 only when exactly one reverse proxy sits in front of Express.
TRUST_PROXY_HOPS=
# Production starts with no fictional reports unless explicitly opted in.
SEED_DEMO_DATA=false
